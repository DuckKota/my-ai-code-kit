{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg_default": "#0d1117",
    "bg_overlay": "#161b22",
    "bg_element": "#21262d",
    "fg_default": "#c9d1d9",
    "fg_muted": "#8b949e",
    "fg_subtle": "#6e7681",
    "border_default": "#30363d",
    "border_subtle": "#21262d",
    "border_active": "#58a6ff",
    "accent_blue": "#58a6ff",
    "accent_purple": "#bc8cff",
    "accent_orange": "#ffa657",
    "status_green": "#3fb950",
    "status_red": "#f85149",
    "status_orange": "#d29922",
    "syntax_comment": "#8b949e",
    "syntax_keyword": "#ff7b72",
    "syntax_string": "#a5d6ff",
    "syntax_function": "#d2a8ff",
    "syntax_variable": "#79c0ff",
    "syntax_number": "#79c0ff",
    "syntax_type": "#ffa657",
    "syntax_operator": "#ff7b72",
    "syntax_punctuation": "#c9d1d9",
    "diff_added_bg": "#122b1f",
    "diff_removed_bg": "#2d151b",
    "diff_context_bg": "#161b22"
  },
  "theme": {
    "primary": { "dark": "accent_blue", "light": "accent_blue" },
    "secondary": { "dark": "accent_purple", "light": "accent_purple" },
    "accent": { "dark": "accent_blue", "light": "accent_blue" },
    "error": { "dark": "status_red", "light": "status_red" },
    "warning": { "dark": "status_orange", "light": "status_orange" },
    "success": { "dark": "status_green", "light": "status_green" },
    "info": { "dark": "accent_blue", "light": "accent_blue" },
    "text": { "dark": "fg_default", "light": "fg_default" },
    "textMuted": { "dark": "fg_muted", "light": "fg_muted" },
    "selectedListItemText": { "dark": "fg_default", "light": "fg_default" },
    "background": { "dark": "bg_default", "light": "bg_default" },
    "backgroundPanel": { "dark": "bg_overlay", "light": "bg_overlay" },
    "backgroundElement": { "dark": "bg_element", "light": "bg_element" },
    "backgroundMenu": { "dark": "bg_element", "light": "bg_element" },
    "border": { "dark": "border_default", "light": "border_default" },
    "borderActive": { "dark": "border_active", "light": "border_active" },
    "borderSubtle": { "dark": "border_subtle", "light": "border_subtle" },
    "diffAdded": { "dark": "status_green", "light": "status_green" },
    "diffRemoved": { "dark": "status_red", "light": "status_red" },
    "diffContext": { "dark": "fg_muted", "light": "fg_muted" },
    "diffHunkHeader": { "dark": "accent_blue", "light": "accent_blue" },
    "diffHighlightAdded": { "dark": "status_green", "light": "status_green" },
    "diffHighlightRemoved": { "dark": "status_red", "light": "status_red" },
    "diffAddedBg": { "dark": "diff_added_bg", "light": "diff_added_bg" },
    "diffRemovedBg": { "dark": "diff_removed_bg", "light": "diff_removed_bg" },
    "diffContextBg": { "dark": "diff_context_bg", "light": "diff_context_bg" },
    "diffLineNumber": { "dark": "fg_muted", "light": "fg_muted" },
    "diffAddedLineNumberBg": { "dark": "diff_added_bg", "light": "diff_added_bg" },
    "diffRemovedLineNumberBg": { "dark": "diff_removed_bg", "light": "diff_removed_bg" },
    "markdownText": { "dark": "fg_default", "light": "fg_default" },
    "markdownHeading": { "dark": "accent_orange", "light": "accent_orange" },
    "markdownLink": { "dark": "accent_blue", "light": "accent_blue" },
    "markdownLinkText": { "dark": "accent_blue", "light": "accent_blue" },
    "markdownCode": { "dark": "syntax_string", "light": "syntax_string" },
    "markdownBlockQuote": { "dark": "fg_muted", "light": "fg_muted" },
    "markdownEmph": { "dark": "accent_blue", "light": "accent_blue" },
    "markdownStrong": { "dark": "fg_default", "light": "fg_default" },
    "markdownHorizontalRule": { "dark": "border_default", "light": "border_default" },
    "markdownListItem": { "dark": "fg_default", "light": "fg_default" },
    "markdownListEnumeration": { "dark": "fg_default", "light": "fg_default" },
    "markdownImage": { "dark": "accent_blue", "light": "accent_blue" },
    "markdownImageText": { "dark": "accent_blue", "light": "accent_blue" },
    "markdownCodeBlock": { "dark": "fg_default", "light": "fg_default" },
    "syntaxComment": { "dark": "syntax_comment", "light": "syntax_comment" },
    "syntaxKeyword": { "dark": "syntax_keyword", "light": "syntax_keyword" },
    "syntaxFunction": { "dark": "syntax_function", "light": "syntax_function" },
    "syntaxVariable": { "dark": "syntax_variable", "light": "syntax_variable" },
    "syntaxString": { "dark": "syntax_string", "light": "syntax_string" },
    "syntaxNumber": { "dark": "syntax_number", "light": "syntax_number" },
    "syntaxType": { "dark": "syntax_type", "light": "syntax_type" },
    "syntaxOperator": { "dark": "syntax_operator", "light": "syntax_operator" },
    "syntaxPunctuation": { "dark": "syntax_punctuation", "light": "syntax_punctuation" }
  }
}
