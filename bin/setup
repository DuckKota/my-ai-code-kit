#!/usr/bin/env bash

# OpenCode Setup Script
# This script bootstraps OpenCode tool for a git repository.
# In a non-git directory, it prompts before initializing OpenSpec and codebase-memory-mcp.
#
# Requirements:
#  • Git, curl, and a bash-compatible shell

# ---

# This line is often referred to as the "Bash Unofficial Strict Mode"
#
# -e (errexit): Tells the script to exit immediately if a command exits with a non-zero status
#               (indicates an error). Without this, Bash keeps running the next line even if the
#               previous command failed.
# -i (nounset): Causes the script to exit if you try to use a variable that hasn't been defined.
#               This prevents disasters like "rm -rf /$DIR" if $DIR happens to be empty.
# -o pipefail: Ensures that if any command in a pipeline fails (e.g., step1 | step2 | step3), the whole
#              pipeline returns a failure code. Normally, Bash only cares if the last command in the pipe worked.
set -euo pipefail

# Requires Bash 4.2+ for associative arrays and global declarations.
if (( BASH_VERSINFO[0] < 4 )) || { (( BASH_VERSINFO[0] == 4 )) && (( BASH_VERSINFO[1] < 2 )); }
then
    echo "Error: Requires Bash 4.2 or higher." >&2
    echo "Current version: $BASH_VERSION" >&2
    exit 1
fi

# Phase 1: Resolve project root — clone to temp if running remotely
SCRIPT_SRC="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." 2>/dev/null && pwd)" || true

CLEANUP_TMP=false
if [[ -f "$SCRIPT_SRC/src/utils/_logger.sh" ]]
then
    ROOT_DIR="$SCRIPT_SRC"
else
    ROOT_DIR=$(mktemp -d)
    git clone --depth 1 \
        https://github.com/DuckKota/my-opencode-setup.git \
        "$ROOT_DIR"
    CLEANUP_TMP=true
    trap '[[ "$CLEANUP_TMP" == "true" ]] && rm -rf "$ROOT_DIR"' EXIT INT TERM
fi

# Load helpers
source "$ROOT_DIR/src/utils/_logger.sh"
source "$ROOT_DIR/src/utils/_utils.sh"

function _ensure_git_project
{
    log::info "Ensuring Git repository..."
    CWD=$(pwd -P)
    if ! util::is_git_project "$CWD"
    then
        log::error "Not a Git repository: $CWD"
        log::error "Please run this script in the root of a Git project."
        exit 1
    fi
    GIT_DIR=$(git -C "$CWD" rev-parse --show-toplevel 2>/dev/null)
    GIT_DIR=$(cd "$GIT_DIR" && pwd -P)
    log::success "Git repository verified! ($GIT_DIR)"
    log::newline
}

function _resolve_init_root
{
    local tool_name="$1"
    local working_dir
    working_dir=$(pwd -P)

    local root
    if util::is_git_project "$working_dir"
    then
        root=$(git -C "$working_dir" rev-parse --show-toplevel 2>/dev/null)
    else
        log::warn "Not a Git repository: $working_dir"
        if util::prompt_yes_no "Initialize $tool_name in the current directory anyway?" "no"
        then
            root="$working_dir"
        else
            log::warn "Skipping $tool_name"
            return 1
        fi
    fi

    root=$(cd "$root" && pwd -P)
    echo "$root"
    return 0
}

function _install_tool
{
    local name="$1"
    local install_cmd="$2"
    local cmd_name="$3"
    shift 3
    # The rest of the arguments are optional directories to check for the command if it's not on PATH.

    log::warn "$name is not installed."
    if ! util::prompt_yes_no "Install $name now?"
    then
        log::warn "Skipping $name. Install manually and re-run setup."
        return 1
    fi

    if ! eval "$install_cmd"
    then
        log::error "Failed to install $name."
        return 1
    fi

    if ! util::command_exists "$cmd_name"
    then
        local dir
        for dir in "$@"
        do
            if [[ -n "$dir" && -x "$dir/$cmd_name" ]]
            then
                export PATH="$dir:$PATH"
                log::warn "Found $cmd_name in $dir. Added to PATH for this session; add it to your shell config to persist."
                util::prompt_enter
                break
            fi
        done
    fi

    if ! util::command_exists "$cmd_name"
    then
        log::die "$name installed but not found on PATH. Refresh your shell and re-run setup."
    fi

    log::success "$name installed!"
    log::newline
}

function _ensure_openspec_installed
{
    log::info "Ensuring OpenSpec is installed..."
    if ! util::command_exists "openspec"
    then
        if ! _install_tool "OpenSpec" "sudo npm install -g @fission-ai/openspec@latest" "openspec" \
            "$(npm prefix -g 2>/dev/null)/bin" "$HOME/.local/bin"
        then
            log::error "OpenSpec installation failed."
            return 0
        fi
    fi
    log::success "OpenSpec verified!"
    log::newline
    if ! _init_openspec
    then
        log::error "OpenSpec initialization failed."
    fi
    log::newline
}

function _ensure_codebase_memory_mcp_installed
{
    log::info "Ensuring codebase-memory-mcp is installed..."
    if ! util::command_exists "codebase-memory-mcp"
    then
        if ! _install_tool "codebase-memory-mcp" \
            "curl -fsSL https://raw.githubusercontent.com/DeusData/codebase-memory-mcp/main/install.sh | bash -s -- --skip-config" \
            "codebase-memory-mcp" "$HOME/.local/bin"
        then
            log::error "codebase-memory-mcp installation failed."
            return 0
        fi
    fi
    log::success "codebase-memory-mcp verified!"
    log::newline
    if ! _init_codebase_memory_mcp
    then
        log::error "codebase-memory-mcp initialization failed."
    fi
    log::newline
}

