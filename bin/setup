function _update_gitignore
{
    if [[ ! -f "$GIT_DIR/.gitignore" ]] || ! grep -qF ".opencode/" "$GIT_DIR/.gitignore"
    then
        echo "" >> "$GIT_DIR/.gitignore"
        echo "# Ignore OpenCode" >> "$GIT_DIR/.gitignore"
        echo ".opencode/" >> "$GIT_DIR/.gitignore"
    fi
}

function _init_openspec
{
    log::info "Initializing OpenSpec..."

    local init_root
    if ! init_root=$(_resolve_init_root "OpenSpec")
    then
        return 0
    fi

    if ! (cd "$init_root" && openspec init --tools opencode)
    then
        log::error "OpenSpec initialization failed."
        return 1
    fi
    
    log::success "OpenSpec initialized!"
    log::newline
}

function _init_agents_md
{
    local mode="$1"
    local src="$2"
    local dst="$3"

    if [[ "$mode" != "prepend" && "$mode" != "append" ]]
    then
        log::error "Usage: _init_agents_md <prepend|append> <source_file> <target_file>"
        return 1
    fi

    if [[ ! -f "$src" ]]
    then
        log::error "Source file not found: $src"
        return 1
    fi

    local content
    content=$(cat "$src")
    local marker
    marker=$(echo "$content" | head -n1)

    mkdir -p "$(dirname "$dst")"
    touch "$dst"

    if grep -qF "$marker" "$dst"
    then
        log::success "Content already exists in $dst, skipping"
        log::newline
    else
        local tmp_file
        tmp_file=$(mktemp)
        if [[ "$mode" == "append" ]]
        then
            cat "$dst" > "$tmp_file"
            echo "" >> "$tmp_file"
            echo "$content" >> "$tmp_file"
        else
            echo "$content" > "$tmp_file"
            echo "" >> "$tmp_file"
            cat "$dst" >> "$tmp_file"
        fi
        mv "$tmp_file" "$dst"
        log::success "Content written to $dst ($mode)"
        log::newline
    fi
}

function _init_codebase_memory_mcp
{
    log::info "Initializing codebase-memory-mcp..."

    local init_root
    if ! init_root=$(_resolve_init_root "codebase-memory-mcp")
    then
        return 0
    fi

    # Ensure we found the codebase-memory-mcp executable
    local codebase_mcp_install_path
    codebase_mcp_install_path="$(which codebase-memory-mcp 2>/dev/null || true)"
    if [[ -z "$codebase_mcp_install_path" ]]
    then
        log::error "command not found: codebase-memory-mcp"
        return 1
    fi

    # Initialize AGENTS.md with codebase-memory-mcp instructions
    if ! _init_agents_md "prepend" "$ROOT_DIR/src/instructions/codebase-memory-mcp-agents.md" "$init_root/AGENTS.md"
    then
        log::error "Failed to write codebase-memory-mcp instructions to AGENTS.md."
        return 1
    fi

    # This is custom plugin that I wrote, so I don't care to check that it already exists.
    if ! mkdir -p "$init_root/.opencode/plugins"
    then
        log::error "Failed to create $init_root/.opencode/plugins."
        return 1
    fi
    if ! cp "$ROOT_DIR/src/plugins/CodebaseMemoryReminder.ts" "$init_root/.opencode/plugins"
    then
        log::error "Failed to install CodebaseMemoryReminder plugin."
        return 1
    fi

    # Update the projects MCP server list
    if ! mkdir -p "$init_root/.opencode"
    then
        log::error "Failed to create $init_root/.opencode."
        return 1
    fi
    local python_exe
    python_exe="$(util::get_python_exe)"
    if [[ -z "$python_exe" ]]
    then
        log::error "command not found: python3 / python"
        return 1
    fi
    if ! (cd "$init_root" && "$python_exe" -c "import json, os

file_path = '.opencode/opencode.json'

if not os.path.exists(file_path):
    with open(file_path, 'w') as f:
        f.write('{}')

try:
    with open(file_path, 'r+') as f:
        try:
            data = json.load(f)
        except json.JSONDecodeError:
            data = {}

        payload = {
            'codebase-memory-mcp': {
                'enabled': True,
                'type': 'local',
                'command': ['$codebase_mcp_install_path'],
            }
        }

        if 'mcp' not in data:
            data['mcp'] = payload
        else:
            if 'codebase-memory-mcp' not in data['mcp']:
                data['mcp']['codebase-memory-mcp'] = payload['codebase-memory-mcp']
            else:
                pass

        f.seek(0)
        json.dump(data, f, indent=4)
        f.truncate()
except Exception as e:
    print(f'Error updating file: {e}')
")
    then
        log::error "Failed to update .opencode/opencode.json MCP config."
        return 1
    fi

    if ! codebase-memory-mcp config set auto_index true  # auto-index on session start
    then
        log::error "Failed to enable codebase-memory-mcp auto_index."
        return 1
    fi
    if ! codebase-memory-mcp config set auto_watch true  # register background git watcher
    then
        log::error "Failed to enable codebase-memory-mcp auto_watch."
        return 1
    fi

    log::success "codebase-memory-mcp initialized!"
    log::newline
}

function _init_rtk
{
    log::info "Initializing rtk..."
    if ! echo "n" | rtk init --global --opencode
    then
        log::error "rtk initialization failed."
        return 1
    fi
    log::success "rtk initialized!"
    log::newline
}

function _write_command
{
    if (( $# < 1 ))
    then
        echo "Error: Missing argument." >&2
        exit 1
    fi

    local command_name="$1"
    log::info "Globally installing $command_name command..."

    local src_command="$ROOT_DIR/src/commands/$command_name.md"
    local dst_command="$HOME/.config/opencode/commands/$command_name.md"

    if [[ -f "$dst_command" ]]
    then
        local command_current
        command_current=$(cat "$dst_command")
        local command_new
        command_new=$(cat "$src_command")
        if [[ "$command_current" == "$command_new" ]]
        then
            log::success "/$command_name command already set up in $dst_command"
            log::newline
        else
            log::warn "/$command_name command already exists with different content: $dst_command"
            if util::prompt_yes_no "Overwrite with new version" "no"
            then
                mkdir -p "$(dirname "$dst_command")"
                cp "$src_command" "$dst_command"
                log::success "/$command_name command updated in $dst_command"
                log::newline
            else
                log::warn "Skipping /$command_name command"
                log::newline
            fi
        fi
    else
        mkdir -p "$(dirname "$dst_command")"
        cp "$src_command" "$dst_command"
        log::success "/$command_name command written to $dst_command"
        log::newline
    fi
}

function _write_skill
{
    if (( $# < 1 ))
    then
        echo "Error: Missing argument." >&2
        exit 1
    fi

    local skill_name="$1"
    log::info "Globally installing $skill_name skill..."

    local src_dir="$ROOT_DIR/src/skills/$skill_name"
    local dst_dir="$HOME/.config/opencode/skills/$skill_name"

    if [[ ! -d "$src_dir" ]]
    then
        log::error "Skill source not found: $src_dir"
        exit 1
    fi

    if [[ -d "$dst_dir" ]]
    then
        local any_diff=0
        local file rel_path current existing
        while IFS= read -r -d '' file
        do
            rel_path="${file#$src_dir/}"
            current=$(cat "$ROOT_DIR/src/skills/$skill_name/$rel_path")
            existing=$(cat "$dst_dir/$rel_path" 2>/dev/null)
            if [[ "$current" != "$existing" ]]
            then
                any_diff=1
                break
            fi
        done < <(find "$src_dir" -type f -print0)

        if (( any_diff == 0 ))
        then
            log::success "$skill_name skill already set up in $dst_dir"
            log::newline
        else
            log::warn "$skill_name skill already exists with different content: $dst_dir"
            if util::prompt_yes_no "Overwrite with new version" "no"
            then
                local file rel_path target_file
                while IFS= read -r -d '' file
                do
                    rel_path="${file#$src_dir/}"
                    target_file="$dst_dir/$rel_path"
                    mkdir -p "$(dirname "$target_file")"
                    cp "$ROOT_DIR/src/skills/$skill_name/$rel_path" "$target_file"
                done < <(find "$src_dir" -type f -print0)
                log::success "$skill_name skill updated in $dst_dir"
                log::newline
            else
                log::warn "Skipping $skill_name skill"
                log::newline
            fi
        fi
        return 0
    fi

    local file rel_path target_file
    while IFS= read -r -d '' file
    do
        rel_path="${file#$src_dir/}"
        target_file="$dst_dir/$rel_path"
        mkdir -p "$(dirname "$target_file")"
        cp "$ROOT_DIR/src/skills/$skill_name/$rel_path" "$target_file"
    done < <(find "$src_dir" -type f -print0)

    log::success "$skill_name skill written to $dst_dir"
    log::newline
}

function _write_theme
{
    if (( $# < 1 ))
    then
        echo "Error: Missing argument." >&2
        exit 1
    fi

    local theme_name="$1"
    log::info "Globally installing $theme_name theme..."

    local src_file="$ROOT_DIR/src/themes/$theme_name.json"
    local dst_file="$HOME/.config/opencode/themes/$theme_name.json"

    if [[ ! -f "$src_file" ]]
    then
        log::error "Theme source not found: $src_file"
        exit 1
    fi

    mkdir -p "$(dirname "$dst_file")"
    cp "$src_file" "$dst_file"

    log::success "$theme_name theme written to $dst_file"
    log::newline
}

function _set_default_theme
{
    local theme_name="$1"

    local config_dir="$HOME/.config/opencode"
    local tui_file
    if [[ -f "$config_dir/tui.json" ]]
    then
        tui_file="$config_dir/tui.json"
    else
        tui_file="$config_dir/tui.jsonc"
    fi

    local python_exe
    python_exe="$(util::get_python_exe)"
    if [[ -z "$python_exe" ]]
    then
        log::error "command not found: python3 / python"
        return 1
    fi

    if ! "$python_exe" -c "import json, os, sys

config_dir = os.path.expanduser('$config_dir')
tui_file = '$tui_file'

if not os.path.exists(config_dir):
    os.makedirs(config_dir, exist_ok=True)

if not os.path.exists(tui_file):
    with open(tui_file, 'w') as f:
        f.write('{}')

try:
    with open(tui_file, 'r+') as f:
        try:
            data = json.load(f)
        except json.JSONDecodeError:
            print('Not valid JSON (tui.jsonc may contain comments); skipping theme set', file=sys.stderr)
            raise SystemExit(0)

        data['theme'] = '$theme_name'

        f.seek(0)
        json.dump(data, f, indent=2)
        f.truncate()
except SystemExit:
    raise
except Exception as e:
    print(f'Error updating file: {e}', file=sys.stderr)
"
    then
        log::error "Failed to set default theme in $tui_file."
        return 1
    fi

    log::success "Set $theme_name as default theme in $tui_file"
}

function _install_oc_setup
{
    log::info "Globally installing oc-setup command..."

    local src_file="$ROOT_DIR/bin/oc-setup"
    local dst_dir="$HOME/.local/bin"
    local dst_file="$dst_dir/oc-setup"

    if [[ ! -f "$src_file" ]]
    then
        log::error "oc-setup source not found: $src_file"
        exit 1
    fi

    mkdir -p "$dst_dir"
    cp "$src_file" "$dst_file"
    chmod 755 "$dst_file"

    log::success "oc-setup installed to $dst_file"
    log::newline
}

function _write_commit_message_command
{
    log::info "Globally installing commit-message command..."
    local src_command_path="$ROOT_DIR/src/commands/commit-message.md"
    local dst_command_path="$HOME/.config/opencode/commands/commit-message.md"
    local src_script_path="$ROOT_DIR/src/commands/verify-commit"
    local dst_script_path="$HOME/.config/opencode/scripts/verify-commit"

    if [[ -f "$dst_command_path" ]] || [[ -f "$dst_script_path" ]]
    then
        if [[ -f "$dst_command_path" ]] && [[ -f "$dst_script_path" ]]
        then
            local current_script new_script
            current_script=$(cat "$dst_script_path")
            new_script=$(cat "$src_script_path")

            local current_command new_command
            current_command=$(cat "$dst_command_path")
            new_command=$(cat "$src_command_path" | sed "s|<VALIDATE_COMMIT_SCRIPT>|$dst_script_path|g")

            if [[ "$current_command" == "$new_command" ]] && [[ "$current_script" == "$new_script" ]]
            then
                log::success "/commit-message command already set up in $dst_command_path"
                log::newline
                return 0
            fi
        fi

        log::warn "/commit-message command already exists with different content in $dst_command_path"
        if util::prompt_yes_no "Overwrite with new version" "no"
        then
            mkdir -p "$(dirname "$dst_command_path")" "$(dirname "$dst_script_path")"
            cp "$src_command_path" "$dst_command_path"
            cp "$src_script_path" "$dst_script_path"
            chmod 755 "$dst_script_path"
            sed "s|<VALIDATE_COMMIT_SCRIPT>|$dst_script_path|g" "$dst_command_path" > "$dst_command_path.tmp" && mv "$dst_command_path.tmp" "$dst_command_path"
            log::success "/commit-message command updated in $dst_command_path"
            log::newline
        else
            log::warn "Skipping /commit-message command"
            log::newline
        fi
    else
        mkdir -p "$(dirname "$dst_command_path")" "$(dirname "$dst_script_path")"
        cp "$src_command_path" "$dst_command_path"
        cp "$src_script_path" "$dst_script_path"
        chmod 755 "$dst_script_path"
        sed "s|<VALIDATE_COMMIT_SCRIPT>|$dst_script_path|g" "$dst_command_path" > "$dst_command_path.tmp" && mv "$dst_command_path.tmp" "$dst_command_path"
        log::success "/commit-message command written to $dst_command_path"
        log::newline
    fi
}


