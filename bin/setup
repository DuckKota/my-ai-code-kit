#!/usr/bin/env bash

# Bootstrap for my-opencode-setup. This is the only bash in the project.
# All logic lives in python (src/oc.py). Must be run from a clone (see README).
set -euo pipefail

# ROOT_DIR is the repository root; this script lives in ROOT_DIR/bin.
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
ROOT_DIR="$(cd "$BIN_DIR/.." && pwd)"

if [[ ! -f "$ROOT_DIR/manifest.toml" || ! -f "$ROOT_DIR/src/oc.py" ]]
then
    echo "error: bin/setup must be run from a clone of my-opencode-setup" >&2
    echo "       see README for install instructions" >&2
    exit 1
fi

# Locate a Python 3.11+ interpreter: python3 preferred, python as fallback.
PYTHON=""
for candidate in python3 python
do
    if command -v "$candidate" >/dev/null 2>&1 \
        && "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1
    then
        PYTHON="$candidate"
        break
    fi
done

if [[ -z "$PYTHON" ]]
then
    echo "error: python3 (or python, 3.11+) required" >&2
    exit 1
fi

exec "$PYTHON" "$ROOT_DIR/src/oc.py" "$@"
