log::box "Installing Tools"
# _ensure_git_project
_ensure_openspec_installed
_ensure_codebase_memory_mcp_installed
# _ensure_rtk_installed

log::box "Installing Commands"
_write_commit_message_command
_write_command "grill-me"
_write_command "fix"
_write_command "handoff"
_write_command "glab-mr"

log::box "Installing Skills"
_write_skill "diagnosing-bugs"
_write_skill "codebase-design"
_write_skill "domain-modeling"
_write_skill "improve-codebase-architecture"
_write_skill "grilling"
_write_skill "using-git-worktrees"
_write_skill "verification-before-completion"
_write_skill "writing-for-agents"
_write_skill "glab"

log::box "Installing Themes"
_write_theme "github-dark-default"
_set_default_theme "github-dark-default"

log::box "Installing Miscellaneous"
log::info "Globally installing Caveman speak..."
_init_agents_md "prepend" "$ROOT_DIR/src/instructions/caveman.md" "$HOME/.config/opencode/AGENTS.md"
log::info "Globally installing batch file write..."
_init_agents_md "append" "$ROOT_DIR/src/instructions/file-edit-limits.md" "$HOME/.config/opencode/AGENTS.md"
_install_oc_setup

"$ROOT_DIR/src/utils/_print_complete.sh"